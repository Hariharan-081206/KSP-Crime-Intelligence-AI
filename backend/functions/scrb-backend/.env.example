# scrb-backend environment — template. Copy to `.env` and fill in.
# `.env` is gitignored; this file is committed and must stay secret-free.
#
# NOTE: `.env` IS uploaded with the function bundle. Anything secret is better set
# as an Environment Variable on the function in the Catalyst console, which keeps
# it out of the bundle entirely.
#
# No key below crashes the function when unset — it degrades the one feature that
# needs it, and logs a warning at boot.

# --- Runtime -----------------------------------------------------------------
PORT=3000
NODE_ENV=production

# --- Crime Intelligence Chat -> QuickML Knowledge Base RAG -------------------
# Consumed by services/ragService.js. Powers POST /query.
# Console path: QuickML -> Knowledge Base -> View API
#
# The COMPLETE answer URL (not a base — the path is already part of it):
#   https://console.catalyst.zoho.in/quickml/v1/project/<projectId>/rag/answer
# Unset => POST /query returns 503.
RAG_ANSWER_URL=

# Auth — VERIFIED AGAINST THE LIVE PROJECT.
#
# The endpoint key alone is NOT enough, and on its own is not even read: a
# request with no key gets the identical `400 INVALID_TICKET`. Both QuickML
# hosts authenticate on a Zoho OAuth token. services/catalystAuth.js now takes
# that token from the function's own Catalyst credential, so nothing extra is
# needed here — the key below is still sent alongside it.
RAG_ENDPOINT_KEY=

# LEAVE EMPTY in any deployed environment. Zoho access tokens expire in about an
# hour, so a hardcoded one works for a single hour and then fails silently. It
# exists only for probing the endpoint by hand from a laptop, where no Catalyst
# credential is available. When set, it overrides the function credential.
RAG_OAUTH_TOKEN=

# --- Crime Forecast -> QuickML forecast endpoint -----------------------------
# Consumed by services/forecastService.js. Powers POST /predict/forecast.
# Console path: QuickML -> your forecast pipeline -> Endpoints
#
# NO LONGER USED TO ROUTE THE REQUEST. Predictions go through the Catalyst SDK
# (`app.quickML().predict()`), which builds this exact path itself from the
# project id and adds the Zoho credential the endpoint authenticates on. Kept
# for reference; a value pointing anywhere else is ignored, and forecastService
# warns at startup if it does not end in /endpoints/predict.
#   https://api.catalyst.zoho.in/quickml/v1/project/<projectId>/endpoints/predict
QUICKML_FORECAST_ENDPOINT_URL=

# Still required. Unset => POST /predict/forecast returns 503.
QUICKML_FORECAST_ENDPOINT_KEY=

# The single feature the trained pipeline expects. Change only if the model is
# retrained against a different source column.
# QUICKML_FORECAST_DATE_FEATURE=casemaster__crimeregistereddate

# --- Catalyst context (sent as CATALYST-ORG / Environment on RAG calls) ------
CATALYST_ORG_ID=
CATALYST_ENVIRONMENT=Development

# --- Removed — do not re-add -------------------------------------------------
# RAG_ENDPOINT / RAG_API_KEY / RAG_VECTOR_STORE_ID / RAG_LLM_MODEL
#     Described a contract that does not exist: a Bearer-authenticated
#     POST {base}/v1/rag/query taking vector_store_id + model and returning an
#     `output` wrapper. The real endpoint is RAG_ANSWER_URL above — it takes
#     { query } and returns { answer }. There is no vector-store id to supply and
#     no model to choose; the Knowledge Base is configured in the console.
#
# QUICKML_FORECAST_MODEL_ID
#     The old code called catalystApp.quickML().model(id).predict(). What is
#     provisioned is a REST endpoint, not an SDK-addressable model, so there is no
#     model id. Use QUICKML_FORECAST_ENDPOINT_URL/KEY.
#
# QUICKML_INTENT_MODEL_ID / QUICKML_SYNTHESIS_MODEL_ID
#     services/quickmlService.js is unreachable: detectIntent() passes null as the
#     Catalyst app, and it calls `.quickml()` where the SDK method is `quickML()`.
#     Intent extraction is now local and deterministic in ragService.js.

# Production build-time config for Catalyst Web Client Hosting.
# Vite bakes VITE_* variables into the bundle at BUILD time — set real values
# before `npm run build`, not after. This file is committed and secret-free.

# ---------------------------------------------------------------------------
# API base URL
# ---------------------------------------------------------------------------
# Paths in src/api/endpoints.js are prefix-less (`/query`, `/map/hotspots`, …)
# and are joined onto this base. The backend mounts its routers at ROOT, not
# under `/api` — the `/api` prefix is stripped by the API Gateway rule below.
#
# `/api` (relative) is correct when the SPA and the function are served from the
# SAME Catalyst project, and the API Gateway has the catch-all rule:
#
#     ANY /api/{path:(.*)}  ->  /server/scrb-backend/{path}
#
# Same-origin is the recommended setup: no CORS, and the Catalyst Auth session
# cookie is sent automatically (the backend's authMiddleware requires it).
VITE_API_BASE_URL=/api

# If the SPA is hosted on a DIFFERENT origin from the function, set the absolute
# gateway URL instead — e.g.
#   VITE_API_BASE_URL=https://<project-domain>/api
# and additionally:
#   1. set `withCredentials: true` on the axios instance in src/api/apiClient.js
#   2. replace `cors()` in the backend's index.js with
#      `cors({ origin: '<SPA origin>', credentials: true })`
# Allow-all CORS cannot carry credentials, so the session cookie is dropped and
# every authenticated call 401s. See DEPLOY.md.
#
# With no API Gateway rule, target the function root directly:
#   VITE_API_BASE_URL=https://<project-domain>/server/scrb-backend

# ---------------------------------------------------------------------------
# Authentication — nothing to configure here
# ---------------------------------------------------------------------------
# Catalyst Authentication is cookie-based (ZD_CSRF_TOKEN + the Zoho IAM
# cookies). Because the SPA (/app/*) and the API (/api/*) are served from the
# same project domain, the browser attaches the session to every request on its
# own: no token, no header, no `withCredentials`, nothing in this file.
#
# Sign-in is Catalyst's hosted page, wired up in public/client-package.json:
#     "homepage":       "/__catalyst/auth/login"   <- app entry point
#     "login_redirect": "index.html"               <- lands on /app/index.html
# The SPA never hardcodes that URL; on 401 it navigates to `/` and lets Catalyst
# redirect. Roles come from the console via GET /auth/role and are NOT selectable
# in the client.
#
# The former VITE_AUTH_TOKEN / VITE_USER_ID dev-header scheme is gone — the
# backend authenticates via the session and never read those headers.

# Demo mode. When 'true', the §5 Case Record drawer falls back to a bundled
# fixture (src/data/caseRecordFixture.js) if GET /api/case/:caseId/record is
# unavailable — which it currently is (route not implemented). Leave UNSET for
# production so the drawer shows a real error instead of fabricated data.
# VITE_DEMO_MODE=false
